# Get your token from https://www.dropbox.com/developers/apps
DROPBOX_ACCESS_TOKEN=your_access_token_here

# The folder path in Dropbox (leave empty for root, or use /FolderName)
DROPBOX_FOLDER_PATH=/Portfolio

# Vercel Blob token (from Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Secret for manual sync trigger (/api/sync?init=true&secret=...)
SYNC_SECRET=your_secret_here

# Are.na mirror (optional — leave unset to disable). Uses the v3 API.
# Personal Access Token from https://www.are.na/settings/personal-access-tokens
# IMPORTANT: the token's Access level must be read/write, not Read-only.
ARENA_ACCESS_TOKEN=your_arena_token_here
# Channel slug, i.e. the last path segment of the board URL
# (are.na/martijn-mertens/typograaf -> typograaf)
ARENA_CHANNEL_SLUG=typograaf

# Booking emails (Resend — https://resend.com). Without RESEND_API_KEY the
# booking still works, it just sends no mail.
RESEND_API_KEY=re_your_key_here
# Must be on a domain verified in Resend.
BOOKING_FROM_EMAIL=Martijn Mertens <booking@typografie.be>
# Where the "new booking" notification lands.
BOOKING_NOTIFY_EMAIL=martijn@aboutcontact.com
# Reply-to on the client's confirmation.
BOOKING_REPLY_TO=martijn@aboutcontact.com
